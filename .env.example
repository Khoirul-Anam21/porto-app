# Database Configuration (Aiven PostgreSQL)
# Get these from https://console.aiven.io/

DB_HOST=pg-xxxxx.c.aivencloud.com
DB_PORT=5432
DB_NAME=defaultdb
DB_USER=avnadmin
DB_PASSWORD=your_actual_password_here

# Note: Never commit actual DB_PASSWORD to git
